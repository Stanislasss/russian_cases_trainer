# Copy to .env (`cp .env.example .env`) and adjust.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer

# Host is the compose service name `db`; use localhost when connecting from the host machine.
DATABASE_URL=postgres://trainer:trainer@db:5432/trainer

BIND_ADDR=0.0.0.0:8080
# Set to true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
RUST_LOG=info,tower_http=debug

# Piper voice for pronunciations: ru_RU-irina-medium, ru_RU-denis-medium,
# ru_RU-dmitri-medium or ru_RU-ruslan-medium (compare them on http://localhost:5002).
TTS_VOICE=ru_RU-irina-medium
